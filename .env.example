# GEMINI_API_KEY: Required for Gemini AI API calls (transcription, emotion analysis, translation, and Gemini TTS).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ELEVENLABS_API_KEY: Optional - enables native ElevenLabs voices such as Kamran Ahmad (GSSiRsPYkmClFf80bZi2).
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
